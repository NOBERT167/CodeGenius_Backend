        public ActionResult {{ page_name }}()
        {
            try
            {
                if (Session["Username"] == null)
                    return RedirectToAction("Login", "Login");
                return View();
            }
            catch (Exception ex)
            {
                var erroMsg = new Error();
                erroMsg.Message = ex.Message;
                return View("~/Views/Common/ErrorMessange.cshtml", erroMsg);
            }
        }

        {% if filters_enabled %}
        public JsonResult Get{{ page_name }}List({% if date_filter %}string startDate = null, string endDate = null, {% endif %}{% if status_filter %}string status = null{% endif %}{% for custom_filter in custom_filters %}, string {{ custom_filter.field_name|lower }} = null{% endfor %})
        {
            try
            {
                var employee = Session["EmployeeData"] as EmployeeView;
                var userId = employee?.UserID;
                var role = Session["ESSRoleSetup"] as ESSRoleSetup;
                var dimension1 = employee?.GlobalDimension1Code;
                var {{ page_name|lower }}List = new List<{{ model_name }}>();

                {% if date_filter %}
                var (filterStartDate, filterEndDate) = GetDefaultDateRange(startDate, endDate);
                {% endif %}
                {% if status_filter %}
                var filterStatus = status ?? "{{ status_filter.default_value or 'Open' }}";
                {% endif %}

                var filters = new List<string>();

                // Role-based filtering
                {% for user_filter in user_filter_fields %}
                {% if loop.first %}
                if (role != null && (role.Station_Accountant || role.HQ_Accountant))
                {
                    filters.Add($"Global_Dimension_1_Code eq '{dimension1}'");
                }
                else
                {
                    filters.Add($"{{ user_filter.original_name }} eq '{userId}'");
                }
                {% endif %}
                {% endfor %}

                {% if date_filter %}
                // Date filters
                if (!string.IsNullOrEmpty(filterStartDate))
                {
                    filters.Add($"{{ date_filter.field_name }} ge {filterStartDate}");
                }
                if (!string.IsNullOrEmpty(filterEndDate))
                {
                    filters.Add($"{{ date_filter.field_name }} le {filterEndDate}");
                }
                {% endif %}

                {% if status_filter %}
                // Status filter
                if (!string.IsNullOrEmpty(filterStatus))
                {
                    if (filterStatus == "Open,Pending Approval") // Combined status
                    {
                        filters.Add("({{ status_filter.field_name }} eq 'Open' or {{ status_filter.field_name }} eq 'Pending Approval')");
                    }
                    else
                    {
                        filters.Add($"{{ status_filter.field_name }} eq '{filterStatus}'");
                    }
                }
                {% endif %}

                {% for custom_filter in custom_filters %}
                // Custom filter: {{ custom_filter.display_name }}
                if (!string.IsNullOrEmpty({{ custom_filter.field_name|lower }}))
                {
                    filters.Add("{{ custom_filter.field_name }} eq '" + {{ custom_filter.field_name|lower }} + "'");
                }
                {% endfor %}

                var combinedFilter = string.Join(" and ", filters);
                var selectFields = "{{ datatable_properties|map(attribute='original_name')|join(',') }}";
                var page = $"{{ entity_name }}?$filter={combinedFilter}&$select={selectFields}&$orderby={{ date_filter.field_name if date_filter else 'No' }} desc&$format=json";

                var httpResponse = Credentials.GetOdataData(page);
                using (var streamReader = new StreamReader(httpResponse.GetResponseStream()))
                {
                    var result = streamReader.ReadToEnd();
                    var details = JObject.Parse(result);

                    foreach (JObject config in details["value"])
                    {
                        var item = new {{ model_name }}();
                        {% for prop in datatable_properties %}
                        item.{{ prop.csharp_name }} = {% if prop.type == 'DateTime' %}ParseAndFormatDate(GetStringValue(config, "{{ prop.original_name }}")){% else %}GetStringValue(config, "{{ prop.original_name }}"){% endif %};
                        {% endfor %}
                        {{ page_name|lower }}List.Add(item);
                    }
                }

                return Json(new
                {
                    success = true,
                    {{ page_name|lower }}List = {{ page_name|lower }}List,
                    filterInfo = new
                    {
                        {% if date_filter %}
                        startDate = filterStartDate,
                        endDate = filterEndDate,
                        {% endif %}
                        {% if status_filter %}
                        status = filterStatus,
                        {% endif %}
                        recordCount = {{ page_name|lower }}List.Count
                    }
                }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                return Json(new
                {
                    success = false,
                    message = ex.Message.Replace("'", "")
                }, JsonRequestBehavior.AllowGet);
            }
        }

        {% if date_filter %}
        private (string, string) GetDefaultDateRange(string startDate, string endDate)
        {
            var defaultStart = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd");
            var defaultEnd = DateTime.Now.ToString("yyyy-MM-dd");

            return (startDate ?? defaultStart, endDate ?? defaultEnd);
        }
        {% endif %}

        {% if status_filter %}
        public JsonResult Get{{ page_name }}StatusOptions()
        {
            try
            {
                var statusOptions = new List<SelectListItem>
                {
                    {% if status_filter.options %}
                    {% for option in status_filter.options %}
                    new() { Text = "{{ option.text }}", Value = "{{ option.value }}" }{% if not loop.last %},{% endif %}
                    {% endfor %}
                    {% else %}
                    new() { Text = "Open", Value = "Open" },
                    new() { Text = "Pending Approval", Value = "Pending Approval" },
                    new() { Text = "Approved", Value = "Approved" },
                    new() { Text = "Open & Pending", Value = "Open,Pending Approval" }
                    {% endif %}
                };

                return Json(new { success = true, statusOptions }, JsonRequestBehavior.AllowGet);
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = ex.Message.Replace("'", "") }, JsonRequestBehavior.AllowGet);
            }
        }
        {% endif %}

        private string GetStringValue(JObject config, string fieldName)
        {
            try
            {
                return config[fieldName]?.ToString() ?? "";
            }
            catch
            {
                return "";
            }
        }

        private string ParseAndFormatDate(string dateString)
        {
            if (DateTime.TryParse(dateString, out DateTime date))
            {
                return date.ToString("yyyy-MM-dd");
            }
            return dateString;
        }
