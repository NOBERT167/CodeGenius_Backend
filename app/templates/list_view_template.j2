@model IEnumerable<Latest_Staff_Portal.ViewModel.{{ model_name }}>

@*
    STATUS BADGE STYLES — add the following to your site's CSS file (e.g. assets/css/style.css):

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: capitalize;
    }
    .status-open              { background-color: #e3f2fd; color: #1976d2; }
    .status-approved          { background-color: #e8f5e9; color: #2e7d32; }
    .status-pending,
    .status-pending-approval  { background-color: #fff3e0; color: #ef6c00; }
    .status-rejected          { background-color: #ffebee; color: #c62828; }
    .status-canceled          { background-color: #f5f5f5; color: #616161; }
*@

@if (Model == null || !Model.Any())
{
    <div class="empty-state text-center" style="padding: 70px 20px;">
        <i class="fas fa-warning" style="font-size: 40px; color: #e5e7eb; margin-bottom: 18px;"></i>

        <h4 style="color: #334155; margin-bottom: 6px;">
            You're Quiet Here 🙂
        </h4>

        <p style="color: #64748b; max-width: 420px; margin: 0 auto;">
            No {{ page_name|lower }} records found.
            Click 'New {{ page_name }}' to get started.
        </p>
    </div>
}
else
{

<div class="table-responsive">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead style="">
            <tr>
                <th>Action</th>{% for prop in datatable_properties %}
                <th>{{ prop.display_name }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var statusClass = "status-" + ({% for prop in datatable_properties %}{% if prop.original_name.lower() == 'status' %}item.{{ prop.csharp_name }}{% endif %}{% endfor %} ?? "").ToLower().Replace(" ", "-");
                    <tr>
                        <td style="text-align:right">
                            <button class="btn btn-primary btn-sm" onclick="View{{ page_name }}Doc('@item.{{ primary_key.csharp_name if primary_key else 'No' }}');">
                                <i class="fa fa-eye"></i> View
                            </button>
                        </td>{% for prop in datatable_properties %}
                        <td>{% if prop.original_name.lower() == 'status' %}<span class="status-badge @statusClass">@item.{{ prop.csharp_name }}</span>{% elif prop.type == 'DateTime' %}@(item.{{ prop.csharp_name }}.ToShortDateString()){% else %}@item.{{ prop.csharp_name }}{% endif %}</td>{% endfor %}
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $("#datatable-buttons").DataTable({
        lengthChange: true,
        lengthMenu: [5, 10, 25, 50, 100],
        "responsive": true,
        language: {
            emptyTable: "No {{ page_name|lower }} available. Click 'New {{ page_name }}' to add",
            info: "Showing _START_ to _END_ of _TOTAL_ entries",
            infoEmpty: "No entries available",
            zeroRecords: "No matching records found"
        },
        columnDefs: [
            {
                targets: '_all',
                defaultContent: ""
            }
        ]
    });
</script>

}